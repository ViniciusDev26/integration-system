# Keep the build context small and avoid leaking local/dev files into the image.
**/node_modules
**/dist
**/coverage
**/.turbo

# Secrets / local env (never copy into the image)
.env
.env.*
!.env.example

# VCS / tooling / docs not needed at build time
.git
.gitignore
*.log
.vscode
.idea

# api-local ops scripts (large downloads) — not needed in the image
apps/api/scripts

# Container/dev files not needed inside the build
Dockerfile
.dockerignore
docker-compose.yml
