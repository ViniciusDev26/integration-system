# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real secrets.

# --- Server ---
# Port the API listens on (optional; defaults to 3000).
PORT=3000
# Environment: development | test | production (optional; defaults to development).
NODE_ENV=development

# --- Public URL ---
# Public base URL of this API: scheme + host (+ port), NO trailing slash.
# The GitHub OAuth callback is derived from it as:
#   ${PUBLIC_BASE_URL}/auth/github/callback
# This must match the "Authorization callback URL" registered in the GitHub
# OAuth App.
PUBLIC_BASE_URL=http://localhost:3000

# --- GitHub OAuth (ADR 0020) ---
# From your GitHub OAuth App:
#   Settings > Developer settings > OAuth Apps > (your app)
# Generate the secret there; it is shown only once.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Database (PostgreSQL, ADR 0008) ---
# Connection string used by Drizzle. Added here for the upcoming DB foundation;
# set it when the database is wired up.
DATABASE_URL=postgres://user:password@localhost:5432/integration_system
