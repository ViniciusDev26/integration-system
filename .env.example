# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real secrets.

# --- Server ---
# Port the API listens on (optional; defaults to 3000).
PORT=3000
# Environment: development | test | production (optional; defaults to development).
NODE_ENV=development

# --- Public URL ---
# Public base URL of this API: scheme + host (+ port), NO trailing slash.
# The GitHub OAuth callback is derived from it as:
#   ${PUBLIC_BASE_URL}/auth/github/callback
# This must match the "Authorization callback URL" registered in the GitHub
# OAuth App.
PUBLIC_BASE_URL=http://localhost:3000

# --- GitHub OAuth (ADR 0020) ---
# From your GitHub OAuth App:
#   Settings > Developer settings > OAuth Apps > (your app)
# Generate the secret there; it is shown only once.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Database (PostgreSQL, ADR 0008) ---
# Connection string used by Drizzle. Added here for the upcoming DB foundation;
# set it when the database is wired up.
DATABASE_URL=postgres://user:password@localhost:5432/integration_system

# --- Object storage (Cloudflare R2, S3-compatible; ADR 0007/0031) ---
# Audio files are stored in R2. Named vendor-neutrally (STORAGE_*) to match the
# ObjectStorage port. From the Cloudflare dashboard: R2 > (bucket) and an R2 API
# token (Access Key ID + Secret). The account id derives the S3 endpoint
# (https://<account-id>.r2.cloudflarestorage.com).
STORAGE_ACCOUNT_ID=your_cloudflare_account_id
STORAGE_ACCESS_KEY_ID=your_r2_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_r2_secret_access_key
STORAGE_BUCKET=your_r2_bucket_name
