# Package manager configuration — see docs/adrs/0006-npm-package-manager.md

# Pin exact dependency versions on install/update (no ^ or ~ ranges),
# so the installed version is fully deterministic.
save-exact=true

# Enforce the `engines` field declared in package.json. Combined with an
# `engines` entry and an npm-only guard in package.json, this keeps the
# project on the intended package manager and Node/npm versions.
engine-strict=true
