<h1>🎶 {{playlist.name}}</h1>
<p class="subtitle">{{musics.length}} track(s)</p>

{{#if musics.length}}
  <ul class="tracks">
    {{#each musics}}
      <li class="track">
        <div class="track-head">
          {{#if this.thumbnailUrl}}
            <img class="track-thumb" src="{{this.thumbnailUrl}}" alt="" />
          {{else}}
            <div class="track-thumb track-thumb--empty" aria-hidden="true">🎵</div>
          {{/if}}
          <div class="track-meta">
            <span class="track-name">{{this.name}}</span>
            {{#if this.genres.length}}
              <span class="track-genres">
                {{#each this.genres}}<span class="track-genre">{{this}}</span>{{/each}}
              </span>
            {{/if}}
          </div>
        </div>
        <audio class="track-audio" controls preload="none" src="{{this.playbackUrl}}"></audio>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="banner">No tracks yet — add one below.</p>
{{/if}}

<form class="form" method="post" action="/playlists/{{playlist.id}}/musics">
  <label class="field">
    <span>Add a track</span>
    <select name="musicId" required>
      <option value="" disabled selected>Choose a track…</option>
      {{#each allMusics}}
        <option value="{{this.id}}">{{this.name}}</option>
      {{/each}}
    </select>
  </label>
  <button class="btn" type="submit">Add to playlist</button>
</form>

<a class="link" href="/playlists">← Your playlists</a>
