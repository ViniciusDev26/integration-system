<h1>🎶 Your playlists</h1>
<p class="subtitle">Playlists you own</p>

{{#if playlists.length}}
  <ul class="tracks">
    {{#each playlists}}
      <li class="track">
        <a class="playlist-link" href="/playlists/{{this.id}}">{{this.name}}</a>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="banner">No playlists yet.</p>
{{/if}}

<a class="btn" href="/playlists/new">New playlist</a>
<a class="link" href="/">← Back home</a>
