<h1>🎧 Upload a track</h1>
<p class="subtitle">Add a song to Spotifake</p>

{{#if uploaded}}
  <p class="banner success">Track uploaded ✓</p>
{{/if}}

<form class="form" method="post" action="/musics" enctype="multipart/form-data">
  <label class="field">
    <span>Name</span>
    <input type="text" name="name" required maxlength="200" placeholder="Nocturne in E-flat" />
  </label>

  <label class="field">
    <span>Genre</span>
    <input type="text" name="genre" required maxlength="100" placeholder="classical" />
  </label>

  <label class="field">
    <span>Audio file</span>
    <input type="file" name="file" accept="audio/*" required />
  </label>

  <label class="field">
    <span>Thumbnail <small>(optional)</small></span>
    <input type="file" name="thumbnail" accept="image/*" />
  </label>

  <button class="btn" type="submit">Upload</button>
</form>

<a class="link" href="/">← Back home</a>
