{
  "name": "integration-system",
  "version": "0.1.0",
  "private": true,
  "description": "Sample music API (Spotify-like)",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "preinstall": "npx --yes only-allow npm",
    "build": "tsc -p tsconfig.build.json && npm run copy:views",
    "copy:views": "mkdir -p dist/views && cp -r src/views/. dist/views/",
    "start": "node dist/server.js",
    "dev": "npm run copy:views && tsc-watch -p tsconfig.build.json --onSuccess \"node dist/server.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/.bin/drizzle-kit migrate"
  },
  "dependencies": {
    "axios": "1.20.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-handlebars": "9.0.1",
    "express-zod-safe": "3.2.1",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@testcontainers/postgresql": "12.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "tsc-watch": "7.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
